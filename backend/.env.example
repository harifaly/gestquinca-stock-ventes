# Copier ce fichier en .env (commande : copy .env.example .env) puis adapter les valeurs.
# Mot de passe, port et nom de la base : ceux utilisés à la création de la base.
DATABASE_URL=postgresql://gestquinca:gestquinca_dev@localhost:5432/gestquinca
# Clé qui signe les jetons de connexion : à changer pour tout usage autre qu'en démonstration.
JWT_SECRET=changez-moi-avant-de-deployer-cle-longue-de-32-caracteres
JWT_EXPIRE_MINUTES=480
# Adresse de l'interface Vue en développement (Vite)
CORS_ORIGINS=http://localhost:5173
